<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme — UIKA Brand: Hijau Zamrud + Emas -->
    <style name="Theme.UIKANavigator" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorPrimaryVariant">@color/green_dark</item>
        <item name="colorOnPrimary">@color/surface_white</item>
        <item name="colorSecondary">@color/gold_accent</item>
        <item name="colorSecondaryVariant">@color/gold_dark</item>
        <item name="colorOnSecondary">@color/surface_white</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <!-- NOTE: android:colorBackground and android:windowBackground intentionally omitted
             so ARCore/camera feed remains visible as the window background -->
        <item name="colorControlHighlight">@color/ripple_green</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>

    <!-- Input Field: Outlined style (router From/To) -->
    <style name="CustomBox" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="boxStrokeColor">@color/text_input_stroke_uika</item>
        <item name="hintTextColor">@color/text_hint_uika</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <!-- Search bar: Filled style -->
    <style name="CustomSearchBox" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxStrokeColor">@color/text_input_stroke_uika</item>
        <item name="hintTextColor">@color/text_hint_uika</item>
        <item name="boxBackgroundColor">@color/surface_white</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="endIconMode">clear_text</item>
        <item name="startIconDrawable">@drawable/ic_search</item>
        <item name="startIconTint">@color/green_primary</item>
        <item name="endIconTint">@color/text_secondary</item>
    </style>

    <!-- MaterialButton: Primary (Green) -->
    <style name="Button.UIKA.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/green_primary</item>
        <item name="rippleColor">@color/ripple_green</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textColor">@color/surface_white</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="elevation">2dp</item>
    </style>

    <!-- MaterialButton: Outlined (Green border) -->
    <style name="Button.UIKA.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/green_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="rippleColor">@color/ripple_green</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textColor">@color/green_primary</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!-- MaterialButton: Danger (Red) -->
    <style name="Button.UIKA.Danger" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/danger_red</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textColor">@color/surface_white</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="elevation">2dp</item>
    </style>

    <!-- MaterialButton: Gold Accent -->
    <style name="Button.UIKA.Gold" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/gold_accent</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textColor">@color/surface_white</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="elevation">2dp</item>
    </style>

    <!-- Splash Screen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_app_icon</item>
        <item name="windowSplashScreenBackground">@color/green_dark</item>
        <item name="postSplashScreenTheme">@style/Theme.UIKANavigator</item>
    </style>

</resources>